# Copy to backend/.env for running the backend directly with `npm run dev` (outside Docker).

PORT=4000

# Either set DATABASE_URL directly...
DATABASE_URL=postgres://netsentry:change-me@localhost:5432/netsentry_dev
# ...or the individual PG* vars are also read as a fallback by src/config/env.js.

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

SCAN_TARGET_CIDR=192.168.1.0/24
SCAN_CRON_SCHEDULE=*/30 * * * *

# Set to true for local macOS dev, where nmap needs `sudo` for ARP-based MAC
# resolution (see docs/ARCHITECTURE.md). Leave false/unset in Docker on Linux,
# where the container gets NET_ADMIN/NET_RAW capabilities directly instead.
NMAP_USE_SUDO=false

CORS_ORIGIN=http://localhost:5173
