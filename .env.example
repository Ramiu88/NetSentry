# Root env file consumed by docker-compose.yml.
# Copy to .env and fill in real values before running `docker compose up`.

# --- Postgres ---
POSTGRES_DB=netsentry
POSTGRES_USER=netsentry
POSTGRES_PASSWORD=change-me

# --- Backend ---
# DATABASE_URL is derived from the Postgres vars above when running via docker-compose.
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# CIDR of the network to scan, e.g. 192.168.1.0/24
SCAN_TARGET_CIDR=192.168.1.0/24
# Cron expression for scheduled scans (default: every 30 minutes)
SCAN_CRON_SCHEDULE=*/30 * * * *

# --- Frontend ---
# Baked into the frontend's JS bundle at Docker build time. Must be an
# address IT staff's browsers can actually reach — e.g. the server's LAN
# IP/hostname, not "localhost", unless staff only ever use the dashboard
# from the server itself.
BACKEND_PUBLIC_URL=http://localhost:4000
